<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#1B102A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PODSOS  /  COMPANION"
        android:textColor="#C084FC"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_connection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● DISCONNECTED"
            android:textColor="#F0ABFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AIRPODS 4 ANC"
            android:textColor="#B5A0CD"
            android:textSize="9sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#58347F" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BATTERY TELEMETRY"
        android:textColor="#B5A0CD"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingTop="6dp"
        android:paddingBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEFT"
                android:textColor="#B5A0CD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_left_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIGHT"
                android:textColor="#B5A0CD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_right_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASE"
                android:textColor="#B5A0CD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_case_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_noise_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOISE CONTROL  •  UNAVAILABLE"
        android:textColor="#C084FC"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingTop="6dp" />

</LinearLayout>
