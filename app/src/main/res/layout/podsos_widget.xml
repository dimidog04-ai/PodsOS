<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="#1B102A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PODSOS  /  AIRPODS 4 ANC"
        android:textColor="#C084FC"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_connection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● DISCONNECTED"
        android:textColor="#F0ABFC"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingTop="5dp" />

    <TextView
        android:id="@+id/widget_left_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="L --%   R --%   CASE --%"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingTop="8dp" />

    <TextView
        android:id="@+id/widget_noise_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOISE CONTROL • UNAVAILABLE"
        android:textColor="#C084FC"
        android:textSize="10sp"
        android:paddingTop="5dp" />

</LinearLayout>
